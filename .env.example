# Copia este fichero a .env y rellena los valores reales (no se versiona).

# ── Base de datos ─────────────────────────────────────────────────────────
# Credenciales de PostgreSQL. docker-compose las usa tanto para inicializar el
# contenedor como para construir la cadena de conexión del backend.
# OJO: Postgres solo crea el usuario en la PRIMERA inicialización del volumen.
# Si cambias estos valores con el volumen ya creado, hay que recrearlo:
#   docker compose down -v && docker compose up -d
POSTGRES_DB=visualiza
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── Backend ────────────────────────────────────────────────────────────────
# Clave de la API de Claude (Anthropic) usada por el backend para la IA.
# Si se deja vacía, el backend sigue funcionando con el generador mock
# (Anthropic:UseMock = true en appsettings.json).
# OJO al rotarla: con Docker ESTA variable gana sobre backend/src/Visualiza.Api/
# appsettings.Local.json, aunque el bind mount meta ese fichero en el contenedor
# (Program.cs carga los JSON locales ANTES que las variables de entorno, para que
# la cadena de Postgres de Compose no la pise el fichero). Cambiar la clave solo
# en appsettings.Local.json deja el contenedor con la vieja, y el síntoma es un
# 401 de Anthropic que no apunta a la configuración.
ANTHROPIC_API_KEY=

# Secreto de firma de los tokens JWT de las sesiones del experimento.
# Mínimo 32 caracteres: por debajo de eso el backend aborta al arrancar.
# Puede dejarse vacío en desarrollo (docker-compose aplica un valor de prueba),
# pero es OBLIGATORIO definirlo en cualquier despliegue real.
# Para generar uno: openssl rand -base64 48
JWT_SECRET=

# Código MAESTRO del constructor (RF11). Abre cualquier proyecto.
# Cada proyecto tiene además el suyo, que el servidor acuña al crearlo y enseña
# una sola vez; este es el del despliegue, para administrarlo y para entrar a un
# proyecto cuyo código se haya perdido. Los participantes del experimento NO lo
# necesitan: su flujo sigue siendo anónimo.
# Puede dejarse vacío en desarrollo (docker-compose aplica "visualiza-dev"),
# pero es OBLIGATORIO definirlo en cualquier despliegue real: un código vacío
# no abre nada, cierra la llave maestra.
DESIGNER_ACCESS_CODE=

# ¿Puede cualquiera crear un proyecto? (RF11)
# Abierto (true, por defecto) es lo que hace que estrenar el sistema funcione:
# se crea el proyecto y el servidor entrega su código. El precio es que el alta
# devuelve un token válido, así que en un despliegue expuesto a internet equivale
# a regalar la cuota de la API de Claude. Ponlo a false ahí: entonces crear un
# proyecto exige ya tener acceso (la maestra, o el código de otro proyecto).
DESIGNER_OPEN_PROJECT_CREATION=

# ── Frontend ──────────────────────────────────────────────────────────────
# URL base del backend tal como la verá el navegador.
# - Dejar vacío en dev cuando uses `npm run dev` (Vite proxia /api a localhost:5080).
# - Dejar vacío en producción cuando el frontend se sirva tras el mismo Nginx
#   que enruta /api/* al backend (config de frontend/nginx.conf).
# - Rellenar con la URL completa (https://api.midominio.com) si frontend y backend
#   se sirven en hosts distintos (p.ej. frontend en Vercel, backend en Azure).
VITE_API_BASE_URL=
