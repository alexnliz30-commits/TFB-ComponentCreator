{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    // Secreto de desarrollo, solo para ejecutar en local con `dotnet run`.
    // El appsettings.json base lo deja vacío a propósito para no versionar un
    // secreto real; en despliegue debe entrar por la variable JWT_SECRET.
    "Secret": "dev-only-insecure-secret-32-chars-min"
  },
  "Designer": {
    // Código MAESTRO en desarrollo, por la misma razón que el secreto de arriba:
    // sin él, `dotnet run` arrancaría sin ninguna llave que abra los proyectos
    // cuyo código se haya perdido. Cada proyecto tiene además el suyo, que el
    // servidor acuña al crearlo. En despliegue entra por DESIGNER_ACCESS_CODE.
    "AccessCode": "visualiza-dev"
  }
}
